{
  "name": "mayor-o-menor-pokemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "¿Mayor o Menor? Pokémon — ¿quién es más alto o más pesado? Retratos de Mystery Dungeon que se comparan a escala",
  "scripts": {
    "portraits": "node scripts/fetch-portraits.mjs",
    "data": "node scripts/build-data.mjs",
    "setup": "npm run portraits && npm run data",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vitest": "3.0.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
